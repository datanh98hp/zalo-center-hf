DATABASE_URL="postgresql://zalo:change-me@localhost:5432/zalo_center?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-at-least-48-random-characters"
WEBHOOK_SECRET="replace-with-at-least-48-random-characters"

# One-time bootstrap values; remove after initial owner is created.
BOOTSTRAP_TENANT_NAME="Your workspace"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_NAME="Workspace Owner"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Encryption key: exactly 32 bytes encoded as 64 hex chars. Generate with openssl rand -hex 32.
INTEGRATION_ENCRYPTION_KEY="replace-with-64-hex-characters"
ZALO_OA_AUTHORIZE_URL="https://oauth.zaloapp.com/v4/oa/permission"
ZALO_OA_TOKEN_URL="https://oauth.zaloapp.com/v4/oa/access_token"
ZALO_OA_API_BASE="https://openapi.zalo.me/v3.0/oa"
PUBLIC_API_URL="https://api.example.com"
LOGIN_MAX_ATTEMPTS="10"
LOGIN_WINDOW_MINUTES="15"
ZALO_OA_APP_ID="your-zalo-app-id"
ZALO_OA_APP_SECRET="your-zalo-app-secret"
ZALO_OA_REDIRECT_URI="https://api.example.com/api/integrations/oa-oauth/callback"
OUTBOUND_POLL_MS="1500"
