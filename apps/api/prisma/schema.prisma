generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum ContactIdentifierType {
  ZALO_ID
  PHONE
  EMAIL
  EXTERNAL_ID
}

enum IntegrationKind {
  ZALO_OA
  OTHER
  ZALO_PERSONAL_APPROVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model Tenant {
  id          String        @id @default(cuid())
  name        String
  users       User[]
  contacts    Contact[]
  identifiers ContactIdentifier[]
  integrations Integration[]
  quickReplies QuickReply[]
  webhookEvents WebhookEvent[]
  auditLogs AuditLog[]
  webhookCredentials TenantWebhookCredential[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String
  displayName    String
  passwordHash   String
  role           UserRole     @default(AGENT)
  isActive       Boolean      @default(true)
  assignments    Assignment[] @relation("AssignedUser")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, role, isActive])
}

model Contact {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  displayName    String?
  identifiers    ContactIdentifier[]
  assignments    Assignment[]
  conversations  Conversation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, createdAt])
}

model ContactIdentifier {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        ContactIdentifierType
  value       String
  normalized  String
  source      String?
  createdAt   DateTime               @default(now())

  @@unique([tenantId, type, normalized])
}

model Assignment {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  label       String
  assignedBy  String?
  reason      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  endedAt     DateTime?

  @@index([contactId, active])
  @@index([userId, active])
}

model Integration {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind          IntegrationKind
  displayName   String
  externalId    String
  encryptedAuth String?
  isActive      Boolean         @default(false)
  webhookSecretHash String?
  tokenExpiresAt DateTime?
  lastError     String?
  conversations Conversation[]
  outboundJobs  OutboundJob[]
  outboxEvents   OutboxEvent[]
  oauthStates    OAuthState[]
  lastSyncedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, kind, externalId])
}

model Conversation {
  id             String       @id @default(cuid())
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  integrationId  String
  externalId     String
  messages       Message[]
  outboundJobs   OutboundJob[]
  lastMessageAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([integrationId, externalId])
  @@index([contactId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?
  direction      MessageDirection
  status         MessageStatus
  text           String?
  payload        Json?
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model QuickReply {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  body        String
  category    String?
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, isActive, category])
}

model OutboundJob {
  id             String   @id @default(cuid())
  tenantId       String
  integrationId  String
  integration    Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String   @unique
  recipientId    String
  text           String
  status         String   @default("QUEUED")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(8)
  availableAt    DateTime @default(now())
  lockedAt       DateTime?
  lastError      String?
  providerMessageId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, availableAt])
  @@index([tenantId, createdAt])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  tenantId      String
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  eventType     String
  aggregateId   String
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  availableAt   DateTime @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([status, availableAt])
  @@index([tenantId, createdAt])
}

model OAuthState {
  id            String   @id @default(cuid())
  stateHash     String   @unique
  tenantId      String
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())
  @@index([expiresAt])
}

model TenantWebhookCredential {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyHash     String
  keyEncrypted String
  label       String
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  @@unique([tenantId, keyHash])
  @@index([tenantId, revokedAt])
}

model TokenRevocation {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  tenantId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model LoginAttempt {
  id           String   @id @default(cuid())
  identityHash String
  occurredAt   DateTime @default(now())
  succeeded    Boolean  @default(false)
  @@index([identityHash, occurredAt])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idempotencyKey String
  eventType      String
  status         String   @default("RECEIVED")
  requestHash    String
  response       Json?
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}
